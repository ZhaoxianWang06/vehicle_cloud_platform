region                     = "ap-southeast-1"
env                        = "dev"
name                       = "vc-dev"
nat_per_az                 = false
k8s_version                = "1.31"
node_instance_types        = ["t3.medium"]
node_desired               = 2
node_min                   = 2
node_max                   = 4
db_instance_class          = "db.t3.micro"
